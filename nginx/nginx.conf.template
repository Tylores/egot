# Nginx reverse proxy template for SEP2 API Gateway
# This template is processed by generate-nginx-config.sh to create the final nginx.conf
# Variables: LISTEN_ADDR, PORT, SERVER_NAME, TLS_CERT, TLS_KEY, ACCESS_LOG, ERROR_LOG, UPSTREAM_BLOCKS

# user www-data www-data;
worker_processes auto;
error_log {{ ERROR_LOG }} {{ ERROR_LOG_LEVEL }};
pid ./logs/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log {{ ACCESS_LOG }} main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Upstream service definitions
    {{ UPSTREAM_BLOCKS }}

    # Main server block for API gateway
    server {
        listen {{ LISTEN_ADDR }}:{{ PORT }} ssl http2;
        server_name {{ SERVER_NAME }};

        # TLS configuration
        ssl_certificate {{ TLS_CERT }};
        ssl_certificate_key {{ TLS_KEY }};
        ssl_client_certificate ./ssl/ca.crt;
        ssl_verify_client on;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        # Request body size limit
        client_max_body_size 10m;

        # Proxy timeouts
        proxy_connect_timeout {{ PROXY_CONNECT_TIMEOUT }};
        proxy_read_timeout {{ PROXY_READ_TIMEOUT }};
        proxy_send_timeout {{ PROXY_SEND_TIMEOUT }};
        proxy_buffer_size {{ PROXY_BUFFER_SIZE }};

        # Service routing location blocks
        {{ LOCATION_BLOCKS }}
    }
}
