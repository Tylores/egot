  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="CustomerAccountList" wx:samplePath="/bill">
      <doc title="CustomerAccountList">A List of customer accounts</doc>
      <method id="GETCustomerAccountList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:CustomerAccountList"/>
          <representation mediaType="application/sep-exi" element="sep:CustomerAccountList"/>
        </response>
      </method>
      <method id="HEADCustomerAccountList" name="HEAD" wx:mode="M"/>
      <method id="PUTCustomerAccountList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:CustomerAccount"/>
          <representation mediaType="application/sep-exi" element="sep:CustomerAccount"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTCustomerAccountList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:CustomerAccount"/>
          <representation mediaType="application/sep-exi" element="sep:CustomerAccount"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETECustomerAccountList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
