        <request>
          <representation mediaType="application/sep+xml" element="sep:ResponseSet"/>
          <representation mediaType="application/sep-exi" element="sep:ResponseSet"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEResponseSet" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:ResponseSet"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="ResponseList" wx:samplePath="/rsps/{id1}/rsp">
      <doc title="ResponseList">List of Response instances. </doc>
      <method id="GETResponseList" name="GET" wx:mode="O">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:ResponseList"/>
          <representation mediaType="application/sep-exi" element="sep:ResponseList"/>
        </response>
      </method>
      <method id="HEADResponseList" name="HEAD" wx:mode="O"/>
      <method id="PUTResponseList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Response"/>
          <representation mediaType="application/sep-exi" element="sep:Response"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTResponseList" name="POST" wx:mode="M">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Response"/>
          <representation mediaType="application/sep-exi" element="sep:Response"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="204"/>
      </method>
      <method id="DELETEResponseList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
