<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="ResponseSetList" wx:samplePath="/rsps">
      <doc title="ResponseSetList">List of ResponseSet instances or channels. Devices implementing the ResponseSetList resource MAY support multiple instances of ResponseSet</doc>
      <method id="GETResponseSetList" name="GET" wx:mode="O">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:ResponseSetList"/>
          <representation mediaType="application/sep-exi" element="sep:ResponseSetList"/>
        </response>
      </method>
      <method id="HEADResponseSetList" name="HEAD" wx:mode="O"/>
      <method id="PUTResponseSetList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ResponseSet"/>
          <representation mediaType="application/sep-exi" element="sep:ResponseSet"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTResponseSetList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ResponseSet"/>
          <representation mediaType="application/sep-exi" element="sep:ResponseSet"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEResponseSetList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
    <resource id="ResponseSet" wx:samplePath="/rsps/{id1}">
      <doc title="ResponseSet">Specific ResponseSet instance. This resource can be thought of as a particular ResponseList or channel.</doc>
      <method id="GETResponseSet" name="GET" wx:mode="O">
        <response>
          <representation mediaType="application/sep+xml" element="sep:ResponseSet"/>
          <representation mediaType="application/sep-exi" element="sep:ResponseSet"/>
        </response>
      </method>
