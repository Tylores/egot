        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
      <wx:sampleParam name="id3" style="template" type="idType"/>
      <wx:sampleParam name="id4" style="template" type="idType"/>
    </resource>
  </resources>
</application>
