      </method>
      <method id="POSTConsumptionTariffIntervalList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ConsumptionTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:ConsumptionTariffInterval"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEConsumptionTariffIntervalList" name="DELETE" wx:mode="E">
        <response status="400"/>
