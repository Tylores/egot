<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="TariffProfileList" wx:samplePath="/tp">
      <doc title="TariffProfileList">List of TariffProfile instances.</doc>
      <method id="GETTariffProfileList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:TariffProfileList"/>
          <representation mediaType="application/sep-exi" element="sep:TariffProfileList"/>
        </response>
      </method>
      <method id="HEADTariffProfileList" name="HEAD" wx:mode="M"/>
      <method id="PUTTariffProfileList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TariffProfile"/>
          <representation mediaType="application/sep-exi" element="sep:TariffProfile"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTTariffProfileList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TariffProfile"/>
          <representation mediaType="application/sep-exi" element="sep:TariffProfile"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETETariffProfileList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
    <resource id="TariffProfile" wx:samplePath="/tp/{id1}">
      <doc title="TariffProfile">Specific TariffProfile instance.  Allows clients to obtain information about the rate code. </doc>
      <method id="GETTariffProfile" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:TariffProfile"/>
          <representation mediaType="application/sep-exi" element="sep:TariffProfile"/>
        </response>
      </method>
      <method id="HEADTariffProfile" name="HEAD" wx:mode="M"/>
      <method id="PUTTariffProfile" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TariffProfile"/>
          <representation mediaType="application/sep-exi" element="sep:TariffProfile"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTTariffProfile" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TariffProfile"/>
          <representation mediaType="application/sep-exi" element="sep:TariffProfile"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETETariffProfile" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:TariffProfile"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="RateComponentList" wx:samplePath="/tp/{id1}/rc">
      <doc title="RateComponentList">List of RateComponent instances.  This list  specifies a rate-specific container for the charges associated with a specific ReadingType, also referenced by the Metering function set.</doc>
      <method id="GETRateComponentList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:RateComponentList"/>
          <representation mediaType="application/sep-exi" element="sep:RateComponentList"/>
        </response>
      </method>
      <method id="HEADRateComponentList" name="HEAD" wx:mode="M"/>
      <method id="PUTRateComponentList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:RateComponent"/>
          <representation mediaType="application/sep-exi" element="sep:RateComponent"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTRateComponentList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:RateComponent"/>
          <representation mediaType="application/sep-exi" element="sep:RateComponent"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETERateComponentList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="RateComponent" wx:samplePath="/tp/{id1}/rc/{id2}">
      <doc title="RateComponent">Specific RateComponent instance.  Includes link(s) to the list of TimeTariffIntervals that apply to referenced ReadingType for the RateComponent instance.</doc>
      <method id="GETRateComponent" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:RateComponent"/>
          <representation mediaType="application/sep-exi" element="sep:RateComponent"/>
        </response>
      </method>
      <method id="HEADRateComponent" name="HEAD" wx:mode="M"/>
      <method id="PUTRateComponent" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:RateComponent"/>
          <representation mediaType="application/sep-exi" element="sep:RateComponent"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTRateComponent" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:RateComponent"/>
          <representation mediaType="application/sep-exi" element="sep:RateComponent"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETERateComponent" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:RateComponent"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
    <resource id="ActiveTimeTariffIntervalList" wx:samplePath="/tp/{id1}/rc/{id2}/acttti">
      <doc title="ActiveTimeTariffIntervalList">DEPRECATED.</doc>
      <method id="GETActiveTimeTariffIntervalList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffIntervalList"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffIntervalList"/>
        </response>
      </method>
      <method id="HEADActiveTimeTariffIntervalList" name="HEAD" wx:mode="M"/>
      <method id="PUTActiveTimeTariffIntervalList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffInterval"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTActiveTimeTariffIntervalList" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffInterval"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEActiveTimeTariffIntervalList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
    <resource id="TimeTariffIntervalList" wx:samplePath="/tp/{id1}/rc/{id2}/tti">
      <doc title="TimeTariffIntervalList">Collection of TimeTariffInterval instances, including associated ConsumptionTariffInterval.</doc>
      <method id="GETTimeTariffIntervalList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffIntervalList"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffIntervalList"/>
        </response>
      </method>
      <method id="HEADTimeTariffIntervalList" name="HEAD" wx:mode="M"/>
      <method id="PUTTimeTariffIntervalList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffInterval"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTTimeTariffIntervalList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffInterval"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETETimeTariffIntervalList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
    <resource id="TimeTariffInterval" wx:samplePath="/tp/{id1}/rc/{id2}/tti/{id3}">
      <doc title="TimeTariffInterval">Specific TimeTariffInterval instance that represents a unique usage interval and associated charges for the premises.</doc>
      <method id="GETTimeTariffInterval" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffInterval"/>
        </response>
      </method>
      <method id="HEADTimeTariffInterval" name="HEAD" wx:mode="M"/>
      <method id="PUTTimeTariffInterval" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffInterval"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTTimeTariffInterval" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:TimeTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:TimeTariffInterval"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETETimeTariffInterval" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:TimeTariffInterval"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
      <wx:sampleParam name="id3" style="template" type="idType"/>
    </resource>
    <resource id="ConsumptionTariffIntervalList" wx:samplePath="/tp/{id1}/rc/{id2}/tti/{id3}/cti">
      <doc title="ConsumptionTariffIntervalList">List of ConsumptionTariffInterval instances.</doc>
      <method id="GETConsumptionTariffIntervalList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:ConsumptionTariffIntervalList"/>
          <representation mediaType="application/sep-exi" element="sep:ConsumptionTariffIntervalList"/>
        </response>
      </method>
      <method id="HEADConsumptionTariffIntervalList" name="HEAD" wx:mode="M"/>
      <method id="PUTConsumptionTariffIntervalList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ConsumptionTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:ConsumptionTariffInterval"/>
        </request>
        <response status="400"/>
