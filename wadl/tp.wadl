      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
      <wx:sampleParam name="id3" style="template" type="idType"/>
    </resource>
    <resource id="ConsumptionTariffInterval" wx:samplePath="/tp/{id1}/rc/{id2}/tti/{id3}/cti/{id4}">
      <doc title="ConsumptionTariffInterval">Specific ConsumptionTariffInterval instance.</doc>
      <method id="GETConsumptionTariffInterval" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:ConsumptionTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:ConsumptionTariffInterval"/>
        </response>
      </method>
      <method id="HEADConsumptionTariffInterval" name="HEAD" wx:mode="M"/>
      <method id="PUTConsumptionTariffInterval" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ConsumptionTariffInterval"/>
          <representation mediaType="application/sep-exi" element="sep:ConsumptionTariffInterval"/>
        </request>
        <response status="400"/>
