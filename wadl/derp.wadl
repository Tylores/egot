<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="DERProgramList" wx:samplePath="/derp">
      <doc title="DERProgramList">List of DERProgram instances. Devices implementing the DERProgramList resource MAY support multiple instances of DERPrograms.</doc>
      <method id="GETDERProgramList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERProgramList"/>
          <representation mediaType="application/sep-exi" element="sep:DERProgramList"/>
        </response>
      </method>
      <method id="HEADDERProgramList" name="HEAD" wx:mode="M"/>
      <method id="PUTDERProgramList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERProgram"/>
          <representation mediaType="application/sep-exi" element="sep:DERProgram"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDERProgramList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERProgram"/>
          <representation mediaType="application/sep-exi" element="sep:DERProgram"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEDERProgramList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
    <resource id="DERProgram" wx:samplePath="/derp/{id1}">
      <doc title="DERProgram">Specific DER Control Program collection resource.  This resource can be thought of as a particular DERProgram endpoint.  This representation contains simple management attributes, as well as each associated resource.</doc>
      <method id="GETDERProgram" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERProgram"/>
          <representation mediaType="application/sep-exi" element="sep:DERProgram"/>
        </response>
      </method>
      <method id="HEADDERProgram" name="HEAD" wx:mode="M"/>
      <method id="PUTDERProgram" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERProgram"/>
          <representation mediaType="application/sep-exi" element="sep:DERProgram"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDERProgram" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERProgram"/>
          <representation mediaType="application/sep-exi" element="sep:DERProgram"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEDERProgram" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:DERProgram"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="ActiveDERControlList" wx:samplePath="/derp/{id1}/actderc">
      <doc title="ActiveDERControlList">DEPRECATED.</doc>
      <method id="GETActiveDERControlList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERControlList"/>
          <representation mediaType="application/sep-exi" element="sep:DERControlList"/>
        </response>
      </method>
      <method id="HEADActiveDERControlList" name="HEAD" wx:mode="M"/>
      <method id="PUTActiveDERControlList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DERControl"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTActiveDERControlList" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DERControl"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEActiveDERControlList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="DERControlList" wx:samplePath="/derp/{id1}/derc">
      <doc title="DERControlList">List of DERControls.  Devices implementing the DERControlList resource MAY support multiple DERControls.</doc>
      <method id="GETDERControlList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERControlList"/>
          <representation mediaType="application/sep-exi" element="sep:DERControlList"/>
        </response>
      </method>
      <method id="HEADDERControlList" name="HEAD" wx:mode="M"/>
      <method id="PUTDERControlList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DERControl"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDERControlList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DERControl"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEDERControlList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="DERControl" wx:samplePath="/derp/{id1}/derc/{id2}">
      <doc title="DERControl">Specific DERControl resource.  This resource can be thought of as a particular DER control event for a period of time.</doc>
      <method id="GETDERControl" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DERControl"/>
        </response>
      </method>
      <method id="HEADDERControl" name="HEAD" wx:mode="M"/>
      <method id="PUTDERControl" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DERControl"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDERControl" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DERControl"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEDERControl" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:DERControl"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
    <resource id="DefaultDERControl" wx:samplePath="/derp/{id1}/dderc">
      <doc title="DefaultDERControl">The DefaultDERControl resource.  This resource can be thought of as the default DERControl to be used if no active DERControl event is found.</doc>
      <method id="GETDefaultDERControl" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:DefaultDERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DefaultDERControl"/>
        </response>
      </method>
      <method id="HEADDefaultDERControl" name="HEAD" wx:mode="M"/>
      <method id="PUTDefaultDERControl" name="PUT" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DefaultDERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DefaultDERControl"/>
        </request>
      </method>
      <method id="POSTDefaultDERControl" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DefaultDERControl"/>
          <representation mediaType="application/sep-exi" element="sep:DefaultDERControl"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEDefaultDERControl" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="DERCurveList" wx:samplePath="/derp/{id1}/dc">
      <doc title="DERCurveList">A List of DER curves</doc>
      <method id="GETDERCurveList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERCurveList"/>
          <representation mediaType="application/sep-exi" element="sep:DERCurveList"/>
        </response>
      </method>
      <method id="HEADDERCurveList" name="HEAD" wx:mode="M"/>
      <method id="PUTDERCurveList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERCurve"/>
          <representation mediaType="application/sep-exi" element="sep:DERCurve"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDERCurveList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERCurve"/>
          <representation mediaType="application/sep-exi" element="sep:DERCurve"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEDERCurveList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="DERCurve" wx:samplePath="/derp/{id1}/dc/{id2}">
      <doc title="DERCurve">A DER curve instance</doc>
      <method id="GETDERCurve" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERCurve"/>
          <representation mediaType="application/sep-exi" element="sep:DERCurve"/>
        </response>
      </method>
      <method id="HEADDERCurve" name="HEAD" wx:mode="M"/>
      <method id="PUTDERCurve" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERCurve"/>
          <representation mediaType="application/sep-exi" element="sep:DERCurve"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDERCurve" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DERCurve"/>
          <representation mediaType="application/sep-exi" element="sep:DERCurve"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEDERCurve" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:DERCurve"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
  </resources>
</application>
