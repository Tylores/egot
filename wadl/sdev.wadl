<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="SelfDevice" wx:samplePath="/sdev">
      <doc title="SelfDevice">The device that is providing the services being accessed. </doc>
      <method id="GETSelfDevice" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:SelfDevice"/>
          <representation mediaType="application/sep-exi" element="sep:SelfDevice"/>
        </response>
      </method>
      <method id="HEADSelfDevice" name="HEAD" wx:mode="M"/>
      <method id="PUTSelfDevice" name="PUT" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SelfDevice"/>
          <representation mediaType="application/sep-exi" element="sep:SelfDevice"/>
        </request>
      </method>
      <method id="POSTSelfDevice" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SelfDevice"/>
          <representation mediaType="application/sep-exi" element="sep:SelfDevice"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETESelfDevice" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
  </resources>
</application>
