<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="PrepaymentList" wx:samplePath="/ppy">
      <doc title="PrepaymentList">A List of Prepayment instances.</doc>
      <method id="GETPrepaymentList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:PrepaymentList"/>
          <representation mediaType="application/sep-exi" element="sep:PrepaymentList"/>
        </response>
      </method>
      <method id="HEADPrepaymentList" name="HEAD" wx:mode="M"/>
      <method id="PUTPrepaymentList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Prepayment"/>
          <representation mediaType="application/sep-exi" element="sep:Prepayment"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTPrepaymentList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Prepayment"/>
          <representation mediaType="application/sep-exi" element="sep:Prepayment"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEPrepaymentList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
    <resource id="Prepayment" wx:samplePath="/ppy/{id1}">
      <doc title="Prepayment">A particular Prepayment instance. Provides links to the Account Balance, Credit Register, and Operation Status resources for a particular service.</doc>
      <method id="GETPrepayment" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:Prepayment"/>
          <representation mediaType="application/sep-exi" element="sep:Prepayment"/>
        </response>
      </method>
      <method id="HEADPrepayment" name="HEAD" wx:mode="M"/>
      <method id="PUTPrepayment" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Prepayment"/>
          <representation mediaType="application/sep-exi" element="sep:Prepayment"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTPrepayment" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Prepayment"/>
          <representation mediaType="application/sep-exi" element="sep:Prepayment"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEPrepayment" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:Prepayment"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="AccountBalance" wx:samplePath="/ppy/{id1}/ab">
      <doc title="AccountBalance">Account Balance instance. </doc>
      <method id="GETAccountBalance" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:AccountBalance"/>
          <representation mediaType="application/sep-exi" element="sep:AccountBalance"/>
        </response>
      </method>
      <method id="HEADAccountBalance" name="HEAD" wx:mode="M"/>
      <method id="PUTAccountBalance" name="PUT" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AccountBalance"/>
          <representation mediaType="application/sep-exi" element="sep:AccountBalance"/>
        </request>
      </method>
      <method id="POSTAccountBalance" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AccountBalance"/>
          <representation mediaType="application/sep-exi" element="sep:AccountBalance"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEAccountBalance" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="PrepayOperationStatus" wx:samplePath="/ppy/{id1}/os">
      <doc title="PrepayOperationStatus">The Operation Status for the given service. Identifies whether service should be continued. MAY also include other status information, such as low credit warning.</doc>
      <method id="GETPrepayOperationStatus" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:PrepayOperationStatus"/>
          <representation mediaType="application/sep-exi" element="sep:PrepayOperationStatus"/>
        </response>
      </method>
      <method id="HEADPrepayOperationStatus" name="HEAD" wx:mode="M"/>
      <method id="PUTPrepayOperationStatus" name="PUT" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:PrepayOperationStatus"/>
          <representation mediaType="application/sep-exi" element="sep:PrepayOperationStatus"/>
        </request>
      </method>
      <method id="POSTPrepayOperationStatus" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:PrepayOperationStatus"/>
          <representation mediaType="application/sep-exi" element="sep:PrepayOperationStatus"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEPrepayOperationStatus" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="ActiveSupplyInterruptionOverrideList" wx:samplePath="/ppy/{id1}/actsi">
      <doc title="ActiveSupplyInterruptionOverrideList">DEPRECATED.</doc>
      <method id="GETActiveSupplyInterruptionOverrideList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverrideList"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverrideList"/>
        </response>
      </method>
      <method id="HEADActiveSupplyInterruptionOverrideList" name="HEAD" wx:mode="M"/>
      <method id="PUTActiveSupplyInterruptionOverrideList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverride"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverride"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTActiveSupplyInterruptionOverrideList" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverride"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverride"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEActiveSupplyInterruptionOverrideList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="SupplyInterruptionOverrideList" wx:samplePath="/ppy/{id1}/si">
      <doc title="SupplyInterruptionOverrideList">A List of Supply Interruption Override instances.</doc>
      <method id="GETSupplyInterruptionOverrideList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverrideList"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverrideList"/>
        </response>
      </method>
      <method id="HEADSupplyInterruptionOverrideList" name="HEAD" wx:mode="M"/>
      <method id="PUTSupplyInterruptionOverrideList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverride"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverride"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTSupplyInterruptionOverrideList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverride"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverride"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETESupplyInterruptionOverrideList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="SupplyInterruptionOverride" wx:samplePath="/ppy/{id1}/si/{id2}">
      <doc title="SupplyInterruptionOverride">A particular Supply Interruption Override instance. This defines a period of time during which supply would not be interrupted even if available credit has been exhausted.</doc>
      <method id="GETSupplyInterruptionOverride" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverride"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverride"/>
        </response>
      </method>
      <method id="HEADSupplyInterruptionOverride" name="HEAD" wx:mode="M"/>
      <method id="PUTSupplyInterruptionOverride" name="PUT" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverride"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverride"/>
        </request>
      </method>
      <method id="POSTSupplyInterruptionOverride" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:SupplyInterruptionOverride"/>
          <representation mediaType="application/sep-exi" element="sep:SupplyInterruptionOverride"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETESupplyInterruptionOverride" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:SupplyInterruptionOverride"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
    <resource id="CreditRegisterList" wx:samplePath="/ppy/{id1}/cr">
      <doc title="CreditRegisterList">A List of Credit Register instances. Interface for new credit transactions.</doc>
      <method id="GETCreditRegisterList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:CreditRegisterList"/>
          <representation mediaType="application/sep-exi" element="sep:CreditRegisterList"/>
        </response>
      </method>
      <method id="HEADCreditRegisterList" name="HEAD" wx:mode="M"/>
      <method id="PUTCreditRegisterList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:CreditRegister"/>
          <representation mediaType="application/sep-exi" element="sep:CreditRegister"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTCreditRegisterList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:CreditRegister"/>
          <representation mediaType="application/sep-exi" element="sep:CreditRegister"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETECreditRegisterList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="CreditRegister" wx:samplePath="/ppy/{id1}/cr/{id2}">
      <doc title="CreditRegister">A particular Credit Register instance. Records a payment transaction or other credit addition.</doc>
      <method id="GETCreditRegister" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:CreditRegister"/>
          <representation mediaType="application/sep-exi" element="sep:CreditRegister"/>
        </response>
      </method>
      <method id="HEADCreditRegister" name="HEAD" wx:mode="M"/>
      <method id="PUTCreditRegister" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:CreditRegister"/>
          <representation mediaType="application/sep-exi" element="sep:CreditRegister"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTCreditRegister" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:CreditRegister"/>
          <representation mediaType="application/sep-exi" element="sep:CreditRegister"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETECreditRegister" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:CreditRegister"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
  </resources>
</application>
