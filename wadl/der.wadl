<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="DERList" wx:samplePath="/edev/{id1}/der">
      <doc title="DERList">A list of Distributed Energy Resources</doc>
      <method id="GETDERList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:DERList"/>
          <representation mediaType="application/sep-exi" element="sep:DERList"/>
        </response>
      </method>
      <method id="HEADDERList" name="HEAD" wx:mode="M"/>
      <method id="PUTDERList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DER"/>
          <representation mediaType="application/sep-exi" element="sep:DER"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDERList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DER"/>
          <representation mediaType="application/sep-exi" element="sep:DER"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEDERList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
