<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="DeviceCapability" wx:samplePath="/dcap">
      <doc title="DeviceCapability">Used to determine the resources available on a server.</doc>
      <method id="GETDeviceCapability" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:DeviceCapability"/>
          <representation mediaType="application/sep-exi" element="sep:DeviceCapability"/>
        </response>
      </method>
      <method id="HEADDeviceCapability" name="HEAD" wx:mode="M"/>
      <method id="PUTDeviceCapability" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DeviceCapability"/>
          <representation mediaType="application/sep-exi" element="sep:DeviceCapability"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTDeviceCapability" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DeviceCapability"/>
          <representation mediaType="application/sep-exi" element="sep:DeviceCapability"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEDeviceCapability" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
  </resources>
</application>
