<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="FileList" wx:samplePath="/file">
      <doc title="FileList">A list of files</doc>
      <method id="GETFileList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:FileList"/>
          <representation mediaType="application/sep-exi" element="sep:FileList"/>
        </response>
      </method>
      <method id="HEADFileList" name="HEAD" wx:mode="M"/>
      <method id="PUTFileList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:File"/>
          <representation mediaType="application/sep-exi" element="sep:File"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTFileList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:File"/>
          <representation mediaType="application/sep-exi" element="sep:File"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEFileList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
    <resource id="File" wx:samplePath="/file/{id1}">
      <doc title="File">A specific file</doc>
      <method id="GETFile" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:File"/>
          <representation mediaType="application/sep-exi" element="sep:File"/>
        </response>
      </method>
      <method id="HEADFile" name="HEAD" wx:mode="M"/>
      <method id="PUTFile" name="PUT" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:File"/>
          <representation mediaType="application/sep-exi" element="sep:File"/>
        </request>
      </method>
      <method id="POSTFile" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:File"/>
          <representation mediaType="application/sep-exi" element="sep:File"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEFile" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:File"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
  </resources>
</application>
