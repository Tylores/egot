<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="Registration" wx:samplePath="/edev/{id1}/rg">
      <doc title="Registration">Contains registrations related to the indicated device. </doc>
      <method id="GETRegistration" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:Registration"/>
          <representation mediaType="application/sep-exi" element="sep:Registration"/>
        </response>
      </method>
      <method id="HEADRegistration" name="HEAD" wx:mode="M"/>
      <method id="PUTRegistration" name="PUT" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Registration"/>
          <representation mediaType="application/sep-exi" element="sep:Registration"/>
        </request>
      </method>
      <method id="POSTRegistration" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Registration"/>
          <representation mediaType="application/sep-exi" element="sep:Registration"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETERegistration" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:Registration"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="DeviceStatus" wx:samplePath="/edev/{id1}/dstat">
      <doc title="DeviceStatus">Contains the current operational state of the associated EndDevice or SelfDevice.</doc>
      <method id="GETDeviceStatus" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:DeviceStatus"/>
          <representation mediaType="application/sep-exi" element="sep:DeviceStatus"/>
        </response>
      </method>
      <method id="HEADDeviceStatus" name="HEAD" wx:mode="M"/>
      <method id="PUTDeviceStatus" name="PUT" wx:mode="M">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DeviceStatus"/>
          <representation mediaType="application/sep-exi" element="sep:DeviceStatus"/>
        </request>
      </method>
      <method id="POSTDeviceStatus" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:DeviceStatus"/>
          <representation mediaType="application/sep-exi" element="sep:DeviceStatus"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEDeviceStatus" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:DeviceStatus"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="SubscriptionList" wx:samplePath="/edev/{id1}/sub">
      <doc title="SubscriptionList">Contains subscriptions related to the indicated device. Documented in Subscription / Notification Mechanism.</doc>
      <method id="GETSubscriptionList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:SubscriptionList"/>
          <representation mediaType="application/sep-exi" element="sep:SubscriptionList"/>
        </response>
      </method>
      <method id="HEADSubscriptionList" name="HEAD" wx:mode="M"/>
      <method id="PUTSubscriptionList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Subscription"/>
          <representation mediaType="application/sep-exi" element="sep:Subscription"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTSubscriptionList" name="POST" wx:mode="M">
        <request>
          <representation mediaType="application/sep+xml" element="sep:Subscription"/>
          <representation mediaType="application/sep-exi" element="sep:Subscription"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="400">
          <representation mediaType="application/sep+xml" element="sep:Error"/>
          <representation mediaType="application/sep-exi" element="sep:Error"/>
        </response>
      </method>
      <method id="DELETESubscriptionList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="Subscription" wx:samplePath="/edev/{id1}/sub/{id2}">
      <doc title="Subscription">A specific subscription</doc>
      <method id="GETSubscription" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:Subscription"/>
