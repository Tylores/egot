<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="FunctionSetAssignmentsList" wx:samplePath="/edev/{id1}/fsa">
      <doc title="FunctionSetAssignmentsList">Contains function set assignments present on the server and/or related to the indicated device. </doc>
      <method id="GETFunctionSetAssignmentsList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:FunctionSetAssignmentsList"/>
          <representation mediaType="application/sep-exi" element="sep:FunctionSetAssignmentsList"/>
        </response>
      </method>
      <method id="HEADFunctionSetAssignmentsList" name="HEAD" wx:mode="M"/>
      <method id="PUTFunctionSetAssignmentsList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:FunctionSetAssignments"/>
          <representation mediaType="application/sep-exi" element="sep:FunctionSetAssignments"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTFunctionSetAssignmentsList" name="POST" wx:mode="D">
        <request>
          <representation mediaType="application/sep+xml" element="sep:FunctionSetAssignments"/>
          <representation mediaType="application/sep-exi" element="sep:FunctionSetAssignments"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEFunctionSetAssignmentsList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="FunctionSetAssignments" wx:samplePath="/edev/{id1}/fsa/{id2}">
      <doc title="FunctionSetAssignments">Contains links to the specific function set assignments.</doc>
      <method id="GETFunctionSetAssignments" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:FunctionSetAssignments"/>
          <representation mediaType="application/sep-exi" element="sep:FunctionSetAssignments"/>
        </response>
      </method>
      <method id="HEADFunctionSetAssignments" name="HEAD" wx:mode="M"/>
      <method id="PUTFunctionSetAssignments" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:FunctionSetAssignments"/>
          <representation mediaType="application/sep-exi" element="sep:FunctionSetAssignments"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTFunctionSetAssignments" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:FunctionSetAssignments"/>
          <representation mediaType="application/sep-exi" element="sep:FunctionSetAssignments"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEFunctionSetAssignments" name="DELETE" wx:mode="D">
        <response>
          <representation mediaType="application/xml" element="sep:FunctionSetAssignments"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
  </resources>
</application>
