<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="ProxiedDeviceList" wx:samplePath="/edev/{id1}/prxy">
      <doc title="ProxiedDeviceList">Contains a list of proxied devices.</doc>
      <method id="GETProxiedDeviceList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="sFDI" style="query" type="xsd:unsignedLong">
            <doc>SFDI</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:ProxiedDeviceList"/>
          <representation mediaType="application/sep-exi" element="sep:ProxiedDeviceList"/>
        </response>
      </method>
      <method id="HEADProxiedDeviceList" name="HEAD" wx:mode="M"/>
      <method id="PUTProxiedDeviceList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ProxiedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:ProxiedDevice"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTProxiedDeviceList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ProxiedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:ProxiedDevice"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEProxiedDeviceList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="ProxiedDevice" wx:samplePath="/edev/{id1}/prxy/{id2}">
      <doc title="ProxiedDevice">Proxied device instance.</doc>
      <method id="GETProxiedDevice" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:ProxiedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:ProxiedDevice"/>
        </response>
      </method>
      <method id="HEADProxiedDevice" name="HEAD" wx:mode="M"/>
      <method id="PUTProxiedDevice" name="PUT" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ProxiedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:ProxiedDevice"/>
        </request>
      </method>
      <method id="POSTProxiedDevice" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ProxiedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:ProxiedDevice"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEProxiedDevice" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:ProxiedDevice"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
    <resource id="AggregationPriority" wx:samplePath="/edev/{id1}/aggp">
      <doc title="AggregationPriority">Contains aggregation distribution priority order.</doc>
      <method id="GETAggregationPriority" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:AggregationPriority"/>
          <representation mediaType="application/sep-exi" element="sep:AggregationPriority"/>
        </response>
      </method>
      <method id="HEADAggregationPriority" name="HEAD" wx:mode="M"/>
      <method id="PUTAggregationPriority" name="PUT" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AggregationPriority"/>
          <representation mediaType="application/sep-exi" element="sep:AggregationPriority"/>
        </request>
      </method>
      <method id="POSTAggregationPriority" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AggregationPriority"/>
          <representation mediaType="application/sep-exi" element="sep:AggregationPriority"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEAggregationPriority" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:AggregationPriority"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="AggregatedDeviceList" wx:samplePath="/edev/{id1}/adev">
      <doc title="AggregatedDeviceList">Contains a list of aggregated devices.</doc>
      <method id="GETAggregatedDeviceList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="sFDI" style="query" type="xsd:unsignedLong">
            <doc>SFDI</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:AggregatedDeviceList"/>
          <representation mediaType="application/sep-exi" element="sep:AggregatedDeviceList"/>
        </response>
      </method>
      <method id="HEADAggregatedDeviceList" name="HEAD" wx:mode="M"/>
      <method id="PUTAggregatedDeviceList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AggregatedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:AggregatedDevice"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTAggregatedDeviceList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AggregatedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:AggregatedDevice"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEAggregatedDeviceList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="AggregatedDevice" wx:samplePath="/edev/{id1}/adev/{id2}">
      <doc title="AggregatedDevice">Aggregated device instance.</doc>
      <method id="GETAggregatedDevice" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:AggregatedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:AggregatedDevice"/>
        </response>
      </method>
      <method id="HEADAggregatedDevice" name="HEAD" wx:mode="M"/>
      <method id="PUTAggregatedDevice" name="PUT" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AggregatedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:AggregatedDevice"/>
        </request>
      </method>
      <method id="POSTAggregatedDevice" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:AggregatedDevice"/>
          <representation mediaType="application/sep-exi" element="sep:AggregatedDevice"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEAggregatedDevice" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:AggregatedDevice"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
  </resources>
</application>
