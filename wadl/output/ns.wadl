<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="IPInterfaceList" wx:samplePath="/edev/{id1}/ns">
      <doc title="IPInterfaceList">List of IPInterface instances on the associated EndDevice or SelfDevice.</doc>
      <method id="GETIPInterfaceList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:IPInterfaceList"/>
          <representation mediaType="application/sep-exi" element="sep:IPInterfaceList"/>
        </response>
      </method>
      <method id="HEADIPInterfaceList" name="HEAD" wx:mode="M"/>
      <method id="PUTIPInterfaceList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:IPInterface"/>
          <representation mediaType="application/sep-exi" element="sep:IPInterface"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTIPInterfaceList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:IPInterface"/>
          <representation mediaType="application/sep-exi" element="sep:IPInterface"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEIPInterfaceList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="IPInterface" wx:samplePath="/edev/{id1}/ns/{id2}">
      <doc title="IPInterface">Specific IPInterface resource.  This resource may be thought of as network status information for a specific network (IP) layer interface.</doc>
      <method id="GETIPInterface" name="GET" wx:mode="M">
        <response>
