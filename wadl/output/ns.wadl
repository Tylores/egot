          <representation mediaType="application/sep+xml" element="sep:IPInterface"/>
          <representation mediaType="application/sep-exi" element="sep:IPInterface"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEIPInterface" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:IPInterface"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
