<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="MirrorUsagePointList" wx:samplePath="/mup">
      <doc title="MirrorUsagePointList">Mirror Usage point (meter) resource list. Devices implementing the MirrorUsagePointList resource may support multiple instances of meter mirror asset. </doc>
      <method id="GETMirrorUsagePointList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:MirrorUsagePointList"/>
          <representation mediaType="application/sep-exi" element="sep:MirrorUsagePointList"/>
        </response>
      </method>
      <method id="HEADMirrorUsagePointList" name="HEAD" wx:mode="M"/>
      <method id="PUTMirrorUsagePointList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:MirrorUsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:MirrorUsagePoint"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTMirrorUsagePointList" name="POST" wx:mode="M">
        <request>
          <representation mediaType="application/sep+xml" element="sep:MirrorUsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:MirrorUsagePoint"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEMirrorUsagePointList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
    <resource id="MirrorUsagePoint" wx:samplePath="/mup/{id1}">
      <doc title="MirrorUsagePoint">Mirror Usage point instance including resources it supports.</doc>
      <method id="GETMirrorUsagePoint" name="GET" wx:mode="O">
        <response>
          <representation mediaType="application/sep+xml" element="sep:MirrorUsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:MirrorUsagePoint"/>
        </response>
      </method>
      <method id="HEADMirrorUsagePoint" name="HEAD" wx:mode="O"/>
      <method id="PUTMirrorUsagePoint" name="PUT" wx:mode="M">
        <request>
          <representation mediaType="application/sep+xml" element="sep:MirrorUsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:MirrorUsagePoint"/>
        </request>
      </method>
      <method id="POSTMirrorUsagePoint" name="POST" wx:mode="M">
        <request>
          <representation mediaType="application/sep+xml" element="sep:MirrorMeterReadingList"/>
          <representation mediaType="application/sep-exi" element="sep:MirrorMeterReadingList"/>
          <representation mediaType="application/sep+xml" element="sep:MirrorMeterReading"/>
          <representation mediaType="application/sep-exi" element="sep:MirrorMeterReading"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="204"/>
      </method>
      <method id="DELETEMirrorUsagePoint" name="DELETE" wx:mode="M">
        <response>
          <representation mediaType="application/xml" element="sep:MirrorUsagePoint"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
  </resources>
</application>
