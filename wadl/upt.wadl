      <doc title="ReadingType">Meter Reading type</doc>
      <method id="GETReadingType" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:ReadingType"/>
          <representation mediaType="application/sep-exi" element="sep:ReadingType"/>
        </response>
      </method>
      <method id="HEADReadingType" name="HEAD" wx:mode="M"/>
      <method id="PUTReadingType" name="PUT" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ReadingType"/>
          <representation mediaType="application/sep-exi" element="sep:ReadingType"/>
