        </response>
      </method>
      <method id="HEADMeterReading" name="HEAD" wx:mode="M"/>
      <method id="PUTMeterReading" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:MeterReading"/>
          <representation mediaType="application/sep-exi" element="sep:MeterReading"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTMeterReading" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:MeterReading"/>
          <representation mediaType="application/sep-exi" element="sep:MeterReading"/>
        </request>
