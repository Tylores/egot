      </method>
      <method id="POSTReadingSetList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:ReadingSet"/>
          <representation mediaType="application/sep-exi" element="sep:ReadingSet"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEReadingSetList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
    </resource>
    <resource id="ReadingSet" wx:samplePath="/upt/{id1}/mr/{id2}/rs/{id3}">
      <doc title="ReadingSet">Reading Set instance which contains a list of Reading(s)</doc>
      <method id="GETReadingSet" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:ReadingSet"/>
          <representation mediaType="application/sep-exi" element="sep:ReadingSet"/>
