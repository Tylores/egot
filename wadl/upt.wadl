<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wx="urn:ieee:std:2030.5:wadlExt" xmlns:sep="urn:ieee:std:2030.5:ns" xmlns="http://wadl.dev.java.net/2009/02" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd">
  <doc title="SEP 2 Application">SEP 2.2</doc>
  <grammars>
    <include href="sep.xsd"/>
  </grammars>
  <resources wx:sampleBase="http://localhost/sep/">
    <resource id="UsagePointList" wx:samplePath="/upt">
      <doc title="UsagePointList">Usage point resource list. Devices implementing the UsagePointList resource MAY support multiple instances of usage points. </doc>
      <method id="GETUsagePointList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:UsagePointList"/>
          <representation mediaType="application/sep-exi" element="sep:UsagePointList"/>
        </response>
      </method>
      <method id="HEADUsagePointList" name="HEAD" wx:mode="M"/>
      <method id="PUTUsagePointList" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:UsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:UsagePoint"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTUsagePointList" name="POST" wx:mode="O">
        <request>
          <representation mediaType="application/sep+xml" element="sep:UsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:UsagePoint"/>
        </request>
        <response status="200">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
        <response status="201">
          <param name="location" style="header" type="xsd:anyURI" required="true"/>
        </response>
      </method>
      <method id="DELETEUsagePointList" name="DELETE" wx:mode="E">
        <response status="400"/>
        <response status="405"/>
      </method>
    </resource>
    <resource id="UsagePoint" wx:samplePath="/upt/{id1}">
      <doc title="UsagePoint">Usage point instance including links to associated information. </doc>
      <method id="GETUsagePoint" name="GET" wx:mode="M">
        <response>
          <representation mediaType="application/sep+xml" element="sep:UsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:UsagePoint"/>
        </response>
      </method>
      <method id="HEADUsagePoint" name="HEAD" wx:mode="M"/>
      <method id="PUTUsagePoint" name="PUT" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:UsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:UsagePoint"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="POSTUsagePoint" name="POST" wx:mode="E">
        <request>
          <representation mediaType="application/sep+xml" element="sep:UsagePoint"/>
          <representation mediaType="application/sep-exi" element="sep:UsagePoint"/>
        </request>
        <response status="400"/>
        <response status="405"/>
      </method>
      <method id="DELETEUsagePoint" name="DELETE" wx:mode="O">
        <response>
          <representation mediaType="application/xml" element="sep:UsagePoint"/>
        </response>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
    </resource>
    <resource id="MeterReadingList" wx:samplePath="/upt/{id1}/mr">
      <doc title="MeterReadingList">Meter Reading list including explicit URIs for each valid meter reading resource. </doc>
      <method id="GETMeterReadingList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:MeterReadingList"/>
          <representation mediaType="application/sep-exi" element="sep:MeterReadingList"/>
        </response>
      </method>
      <method id="HEADMeterReadingList" name="HEAD" wx:mode="M"/>
      <method id="PUTMeterReadingList" name="PUT" wx:mode="E">
