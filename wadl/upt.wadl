        <response status="405"/>
      </method>
      <wx:sampleParam name="id1" style="template" type="idType"/>
      <wx:sampleParam name="id2" style="template" type="idType"/>
      <wx:sampleParam name="id3" style="template" type="idType"/>
    </resource>
    <resource id="Reading" wx:samplePath="/upt/{id1}/mr/{id2}/rs/{id3}/r/{id4}">
      <doc title="Reading">Reading instance of a particular meter reading type. </doc>
      <method id="GETReading" name="GET" wx:mode="M">
        <response>
