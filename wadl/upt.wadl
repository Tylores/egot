    </resource>
    <resource id="ReadingSetList" wx:samplePath="/upt/{id1}/mr/{id2}/rs">
      <doc title="ReadingSetList">Reading Set list</doc>
      <method id="GETReadingSetList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:ReadingSetList"/>
          <representation mediaType="application/sep-exi" element="sep:ReadingSetList"/>
        </response>
      </method>
      <method id="HEADReadingSetList" name="HEAD" wx:mode="M"/>
      <method id="PUTReadingSetList" name="PUT" wx:mode="E">
        <request>
