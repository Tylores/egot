      <method id="GETReadingList" name="GET" wx:mode="M">
        <request>
          <param name="s" style="query" type="xsd:int">
            <doc>start</doc>
          </param>
          <param name="a" style="query" type="xsd:int">
            <doc>after</doc>
          </param>
          <param name="l" style="query" type="xsd:int">
            <doc>limit</doc>
          </param>
        </request>
        <response>
          <representation mediaType="application/sep+xml" element="sep:ReadingList"/>
          <representation mediaType="application/sep-exi" element="sep:ReadingList"/>
